{
  "$schema": "https://opencode.ai/config.json",

  // BRAIN (cloud frontier model)
  //It is gotta be resp. for planning, architecture, marketing, build mode .
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "build",

  // PROVIDERS
  "providers": {
    // LM Studio runs locally. It is a built-in provider with local model
    // (http://127.0.0.1:1234/v1);
    // pin the endpoint explicitly in that section.
    "lmstudio": {
      "name": "LM Studio",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      // Aliases for the local models.
      // key is the id you use as lmstudio/<key>
      // modelID = the real model name inside LM Studio
      "models": {
        "qwen3-27b-coder": {
          "modelID": "qwen3.8-27b-turbo-fable-cold-fusion-735-882-heretic-uncensored-neo-coder-max-mtp",
          "name": "Qwen3.8 27B Coder (LM Studio)"
        },
        "spark-4b": {
          "modelID": "spark-x2.5-4b",
          "name": "Spark X2.5 4B (LM Studio)"
        },
        "ornith-35b": {
          "modelID": "ornith-1.5-35b-a3b-apex-mtp",
          "name": "Ornith 1.5 35B (LM Studio)"
        },
        "nex-mini": {
          "modelID": "nex-n2.5-mini",
          "name": "Nex 2.5 Mini (LM Studio)"
        }
      }
    }
  },

  // AGENTS
  "agents": {
    // BRAIN: overrides the built-in `build` agent with our own instructions.
    // Each model has its own prompt; this block is the template for customization.
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Brain: planning, architecture, marketing, build mode, test skeleton, review",
      "system": "You are the project brain. Follow Complex projects in AGENTS.md: after the whole plan is approved, choose modules by dependencies and continue through all of them without separate /module requests. Keep one metrics task ID and finalize it after the whole task. Follow the Task metrics section of AGENTS.md: start accounting before implementation, record reviews, run tests through the wrapper, and include the generated report in the final answer. Work through these steps:\n1. PLAN: break the task into steps and update the work plan resolved by the Work plan (memory) section of AGENTS.md.\n2. ARCHITECTURE: propose the file, class, and module structure.\n3. MARKETING: write human-facing text clearly and briefly.\n4. BUILD MODE: draft a skeleton — files, classes, functions, signatures. Inside every function add a DETAILED spec comment: what it does, what it returns, edge cases. Detailed enough that a weak local model can implement it with no guesswork.\n5. TESTS: immediately draft unit tests as a separate dependent project (the `tests/` folder); write the tests against the skeleton. Until the implementation exists the tests fail — that is expected.\n6. DELEGATION: hand implementation pieces to the `executor` subagent (via the subagent tool). Use `executor-fast` for small edits. ONE SUBAGENT — ONE PIECE: a file/function/class.\n7. REVIEW: after the executor replies, read the code, run the tests, fix errors, or send it back. The work is not done until the tests are green."
    },

    // EXECUTOR: local LM Studio model. Implements code from spec comments.
    // no need to be strong, but better to be not quiet silly.
    "executor": {
      "description": "Implements code from spec comments. Local LM Studio model.",
      "mode": "subagent",
      "model": "lmstudio/qwen3-27b-coder",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" }
      ],
      "system": "You are the executor.\nFollow the spec comments in the code strictly. Do not add anything extra, do not change signatures, do not rewrite the skeleton.\nRead the file first, then implement. Report briefly: what you changed, what is left."
    },

    // FAST EXECUTOR: lightweight model for small edits.
    "executor-fast": {
      "description": "Fast executor for simple tasks: small edits, formatting.",
      "mode": "subagent",
      "model": "lmstudio/spark-4b",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" }
      ],
      "system": "Fast executor. Minimal targeted edits from the spec. Nothing extra."
    }
  }
}
