{
  "$schema": "https://opencode.ai/config.json",

  // Моя фронтирная модель архитектор и PM.
  // План, архитектура, маркетинг, билд-режим (для реализации слоя - каркас с комментариями-ТЗ).
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "build",

  // Основные провайдеры, с которыми я работаю.
  "providers": {
    "lmstudio": {
      // LM Studio локально: http://127.0.0.1:1234/v1
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      // Локальные модели, LM Studio.
      // Ключ = id lmstudio/<ключ>, modelID = имя модели в LM Studio.
      "models": {
        "qwen3-27b-coder": {
          "modelID": "qwen3.8-27b-turbo-fable-cold-fusion-735-882-heretic-uncensored-neo-coder-max-mtp",
          "name": "Qwen3.8 27B Coder (LM Studio)"
        },
        "spark-4b": {
          "modelID": "spark-x2.5-4b",
          "name": "Spark X2.5 4B (LM Studio)"
        },
        "ornith-35b": {
          "modelID": "ornith-1.5-35b-a3b-apex-mtp",
          "name": "Ornith 1.5 35B (LM Studio)"
        },
        "nex-mini": {
          "modelID": "nex-n2.5-mini",
          "name": "Nex 2.5 Mini (LM Studio)"
        }
      }
    }
  },

  // АГЕНТЫ
  "agents": {
    //override встроенного build под мои инструкции. Под каждую модель, лучше настроить уникальный промпт. данная шапка - у нас шаблон.
    "build": {
      "description": "Мозг: план, архитектура, маркетинг, билд-режим, каркас тестов, ревью",
      "system": "Ты — мозг проекта. Работаешь по пунктам:\n1. ПЛАН: разбей задачу на шаги, обнови план работ (00. План работ.md в Obsidian).\n2. АРХИТЕКТУРА: предложи структуру файлов, классов, модулей.\n3. МАРКЕТИНГ: тексты для людей — ясно и кратко.\n4. БИЛД-РЕЖИМ: накидай каркас — файлы, классы, функции, сигнатуры. Внутри каждой функции ПОДРОБНЫЙ комментарий-ТЗ: что делает, что вернуть, граничные случаи. Так, чтобы тупой локальной модели хватило на реализацию без догадок.\n5. ТЕСТЫ: сразу накидай каркас юнит-тестов отдельным зависимым проектом (папка tests/), тесты пиши под созданный каркас. Пока реализации нет — тесты падают, это нормально.\n6. ДЕЛЕГИРОВАНИЕ: куски реализации отдавай субагенту executor (через subagent). executor-fast — для мелких правок. ОДНОМУ СУБАГЕНТУ — ОДИН КУСОК: файл/функция/класс.\n7. РЕВЬЮ: после ответа исполнителя прочитай код, гоняй тесты, правь ошибки или отправь на доработку. Пока тесты не зелёные — работа не закончена."
    },

    // Тупой исполнитель: локальная модель LM Studio или дешевая модель опенроутера
    "executor": {
      "description": "Реализует код по комментариям-ТЗ. Локальная модель LM Studio.",
      "mode": "subagent",
      "model": "lmstudio/qwen3.8-27b-turbo-fable-cold-fusion-735-882-heretic-uncensored-neo-coder-max-mtp",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" }
      ],
      "system": "Ты — исполнитель.\nСтрого следуй комментариям-ТЗ в коде. Не добавляй лишнего, не меняй сигнатуры, не переписывай каркас.\nСначала прочитай файл, затем реализуй. Отчитайся кратко: что изменил, что осталось."
    },

    //лёгкая модель для простых правок.
    "executor-fast": {
      "description": "Быстрый исполнитель для простых задач: мелкие правки, форматирование.",
      "mode": "subagent",
      "model": "lmstudio/spark-4b",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" }
      ],
      "system": "Быстрый исполнитель. Минимальные точечные правки по ТЗ. Ничего лишнего."
    }
  }
}